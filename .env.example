# Copy to .env.local for local development, and add the same values in
# Vercel → Project → Settings → Environment Variables for deployments.

# Supabase project URL, e.g. https://abcdefghijkl.supabase.co
SUPABASE_URL=

# Supabase anon / publishable key (Project Settings → API).
# Used only on the server. Do NOT use the service_role / secret key.
SUPABASE_ANON_KEY=

# Public URL of the site, used for canonical and social-sharing links.
# Optional on Vercel (falls back to the production domain).
NEXT_PUBLIC_SITE_URL=

# Required in production. Encrypts the /welcome signup cookie and the links in
# the confirmation email. A long random string, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it invalidates unclicked confirmation and unsubscribe links.
SIGNUP_COOKIE_SECRET=

# Confirmation email (double opt-in) via Resend (resend.com). Leave empty to
# send nothing. EMAIL_FROM must use a domain verified in Resend, e.g.
# Relief <hello@yourdomain.com>
RESEND_API_KEY=
EMAIL_FROM=

# Optional. TikTok Pixel ID (TikTok Ads Manager → Assets → Events). Empty = off.
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# Optional. Shown as the "Contact" link in the footer and on /privacy.
NEXT_PUBLIC_CONTACT_EMAIL=
